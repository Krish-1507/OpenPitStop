# Committed secrets — OpenPitStop flags every one of these (and the committed
# .env file itself). These are FAKE placeholder values; never put real credentials in a repo.
AWS_ACCESS_KEY_ID=example-aws-access-key-id-not-real
STRIPE_SECRET_KEY=example-stripe-secret-key-not-real
JWT_SECRET=example-jwt-secret-not-real
DB_PASSWORD=example-db-password-not-real
DATABASE_URL=postgres://postgres:example-db-password-not-real@db.minishop.internal:5432/minishop
