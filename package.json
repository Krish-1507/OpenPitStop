{
  "name": "openpitstop",
  "version": "1.4.1",
  "description": "Deterministic scans + your coding agent's own reasoning, in one autonomous quality loop. Adds a /pitstop slash-command to any AI coding tool.",
  "license": "MIT",
  "author": "Krish-1507",
  "keywords": [
    "cli",
    "pitstop",
    "code-quality",
    "code-review",
    "ai",
    "autonomous",
    "agent",
    "scan",
    "verify"
  ],
  "type": "module",
  "bin": {
    "openpitstop": "dist/cli.js",
    "pitstop": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "templates",
    "demo-repo",
    "demo-repo-integrity",
    "demo-repo-fintech",
    "demo-repo-generators",
    "README.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krish-1507/OpenPitStop.git"
  },
  "homepage": "https://github.com/Krish-1507/OpenPitStop#readme",
  "bugs": {
    "url": "https://github.com/Krish-1507/OpenPitStop/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "smoke": "node dist/cli.js scan demo-repo",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "execa": "^10.0.1",
    "nock": "^14.0.17",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
